# ============================================================================
# Local Orchestration Environment Variables
# ============================================================================
# Copy this file to .env and fill in the values.
#   cp .env.example .env
#
# Then source it before running scripts:
#   set -a; source .env; set +a
#
# Or use the setup helper:
#   bash scripts/setup-local-env.sh
#
# NOTE: All secret values below are synthetic placeholders.
#       Replace them with real credentials in your .env file.
#       Never commit .env to version control.
# ============================================================================

# ---------------------------------------------------------------------------
# REQUIRED — Orchestration will not start without these
# ---------------------------------------------------------------------------

# GitHub Personal Access Token (org-level PAT)
# Required scopes: repo, workflow, project, read:org
# Used by: gh CLI, opencode MCP GitHub server, orchestrator agent
# Also exported as GH_TOKEN, GITHUB_TOKEN, GITHUB_PERSONAL_ACCESS_TOKEN
GH_ORCHESTRATION_AGENT_TOKEN=FAKE-TOKEN-FOR-TESTING-00000000

# ZhipuAI API key — access to GLM models (primary model provider)
# Required for: opencode dispatch via glm-4.7 (m2 onward)
ZHIPU_API_KEY=FAKE-KEY-FOR-TESTING-00000000

# Kimi / Moonshot API key — optional backup model provider
KIMI_CODE_ORCHESTRATOR_AGENT_API_KEY=FAKE-KEY-FOR-TESTING-00000000

# ---------------------------------------------------------------------------
# OPTIONAL — Additional model providers
# ---------------------------------------------------------------------------

# OpenAI API key (GPT models)
OPENAI_API_KEY=FAKE-KEY-FOR-TESTING-00000000

# Google Gemini API key (mapped to GOOGLE_GENERATIVE_AI_API_KEY in container)
GEMINI_API_KEY=FAKE-KEY-FOR-TESTING-00000000

# ---------------------------------------------------------------------------
# GitHub / Sentinel — Required for m3 (client-dispatch) and later
# ---------------------------------------------------------------------------

# GitHub organization that owns the scratch/target repository
GITHUB_ORG=your-github-org

# GitHub repository name (within the organization above)
GITHUB_REPO=your-github-repo

# GitHub token with repo scope on the scratch repo (used by sentinel for polling)
GITHUB_TOKEN=FAKE-TOKEN-FOR-TESTING-00000000

# Bot login the sentinel claims tasks under (assign-then-verify locking)
SENTINEL_BOT_LOGIN=your-bot-login

# ---------------------------------------------------------------------------
# Server Connection — How the sentinel reaches the orchestration server
# ---------------------------------------------------------------------------

# URL of the orchestration server (opencode serve)
# Default: mission host port 14096 mapped from container port 4096
OPENCODE_SERVER_URL=http://127.0.0.1:14096

# Directory mount the orchestrator should use inside the container
# Default inside image: /opt/orchestration
OPENCODE_SERVER_DIR=/opt/orchestration

# Path to the shell bridge script (devcontainer-opencode.sh prompt subcommand)
# Default: auto-resolves relative to client/src/config.py → client/scripts/devcontainer-opencode.sh
SHELL_BRIDGE_PATH=scripts/devcontainer-opencode.sh

# ---------------------------------------------------------------------------
# Sentinel Tuning — Polling intervals and timeouts
# ---------------------------------------------------------------------------

# Seconds between GitHub polling ticks (default: 60)
POLL_INTERVAL=10

# Maximum backoff in seconds after rate-limit or health-check failure (default: 960)
MAX_BACKOFF=960

# Seconds between heartbeat comments on long-running tasks (default: 300)
HEARTBEAT_INTERVAL=300

# Seconds before shell-bridge subprocess is killed (default: 5700 = 95 min)
SUBPROCESS_TIMEOUT=5700

# ---------------------------------------------------------------------------
# Webhook / Notifier — Phase 3 (optional now, required for live webhook later)
# ---------------------------------------------------------------------------

# HMAC shared secret for GitHub webhook payload validation
WEBHOOK_SECRET=FAKE-SECRET-FOR-TESTING-00000000

# Port for the notifier FastAPI server (default: 8000)
WEBHOOK_PORT=8000
